rules_version = '2';

// Security Rules do BetFriends (KAN-22), conforme docs/firestore-schema.md v2.0.
//
// O backend (Callable Functions/jobs com Admin SDK) ignora estas regras e é o
// único autor de saldos, transações, amizades, partidas e desafios (D-008,
// RN-SEC-001/002/004). O app apenas lê os próprios dados e altera o próprio
// displayName (KAN-29).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Consultas (list) só são aceitas se filtrarem por um campo que comprove
    // a participação do usuário (ex.: participants array-contains uid).
    function isParticipant() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    // users/{uid}: perfil + carteira; privado (RN-PROF-002).
    match /users/{uid} {
      allow get: if isUser(uid);
      allow list: if false;
      // Criação é atômica no backend (perfil + username + INITIAL_BALANCE).
      allow create, delete: if false;
      allow update: if isUser(uid) && validDisplayNameUpdate();

      function validDisplayNameUpdate() {
        let name = request.resource.data.displayName;
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(['displayName', 'updatedAt'])
          && changed.hasAll(['displayName', 'updatedAt'])
          && name is string
          && name == name.trim()
          && name.size() >= 1
          && name.size() <= 60
          && request.resource.data.updatedAt == request.time;
      }
    }

    // usernames/{usernameNormalized}: reserva de username, só backend (KAN-31).
    match /usernames/{usernameNormalized} {
      allow read, write: if false;
    }

    // friendships: leitura pelos participantes; escrita só pelo backend.
    match /friendships/{friendshipId} {
      allow read: if isParticipant();
      allow write: if false;
    }

    // matches: dados públicos da competição, sincronizados pelo backend.
    match /matches/{matchId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // challenges: leitura pelos participantes; estados, palpites, reservas e
    // liquidação só pelo backend.
    match /challenges/{challengeId} {
      allow read: if isParticipant();
      allow write: if false;
    }

    // betCoinTransactions: ledger imutável; leitura só pelo dono.
    match /betCoinTransactions/{transactionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Qualquer outro caminho permanece bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
