<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema aplicado à janela enquanto o processo inicia. Escuro em modo claro e escuro,
         para não haver clarão antes do primeiro frame do Flutter. Removido
         automaticamente quando o Flutter desenha o primeiro frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/bf_fundo</item>
        <item name="android:navigationBarColor">@color/bf_fundo</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <!-- Tema aplicado à janela depois que o processo iniciou; define a cor da
         janela atrás da interface do Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/bf_fundo</item>
        <item name="android:statusBarColor">@color/bf_fundo</item>
        <item name="android:navigationBarColor">@color/bf_fundo</item>
    </style>
</resources>
