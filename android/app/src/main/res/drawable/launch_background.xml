<?xml version="1.0" encoding="utf-8"?>
<!-- Abertura nativa (Android 11 ou anterior): fundo escuro da marca e o
     monograma BF centralizado, igual no modo claro e no escuro. No Android 12+
     o sistema usa o tema de values-v31. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/bf_fundo" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
