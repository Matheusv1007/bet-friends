<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: abertura do sistema com fundo escuro da marca e o monograma
         (splash_icon tem a margem exigida: figura dentro do círculo de 192 dp). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/bf_fundo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/bf_fundo</item>
        <item name="android:navigationBarColor">@color/bf_fundo</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/bf_fundo</item>
        <item name="android:statusBarColor">@color/bf_fundo</item>
        <item name="android:navigationBarColor">@color/bf_fundo</item>
    </style>
</resources>
